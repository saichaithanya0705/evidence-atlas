# ==============================================================================
# AI-Powered Medical Research Abstract Finder - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# NVIDIA NIM / LLM API Configuration (FEAT-R1-03)
# ------------------------------------------------------------------------------
# Administrator access now uses locally provisioned accounts and secure sessions.
# Legacy ADMIN_API_KEY values are ignored by the API.
APP_DATABASE_PATH=./data/app/evidence_atlas.sqlite3

# Optional NCBI E-utilities credentials for PubMed benchmark adjudication.
# NCBI_API_KEY raises the EFetch limit to 10 requests/second (otherwise 3).
# NCBI_EMAIL is sent only when provided; the API-key value is never logged.
NCBI_API_KEY=
NCBI_EMAIL=

# Your personal NVIDIA API Key from https://build.nvidia.com/
# Leave empty or set LLM_MODE=mock if running offline or in demo mode.
NVIDIA_API_KEY=

# NVIDIA NIM OpenAI-compatible endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Preferred LLM on NVIDIA NIM
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Execution mode: "nim" (live NVIDIA API), "mock" (deterministic offline fixtures), or "openai".
# Mock mode validates software flows only; it is not live planner or semantic-judge intelligence.
LLM_MODE=mock

# Generation parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_SYNTHESIS_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30.0
# Bounded JSON-only planner, judge and verification calls.
LLM_STRUCTURED_TIMEOUT_SECONDS=10.0
# Longer report generation remains capped by LLM_TIMEOUT_SECONDS.
LLM_SYNTHESIS_TIMEOUT_SECONDS=30.0
# Starts with the first provider call, reserving time for final validation.
LLM_RESEARCH_BUDGET_SECONDS=60.0
# Keep false for the low-latency path; the optional remote judge still runs
# when deterministic evidence is partial, insufficient, or incompletely covered.
LLM_JUDGE_ON_SUFFICIENT=false
# Optional startup preload; use with retained MedCPT models and sufficient memory.
RESEARCH_PRELOAD_MODELS=false

# ------------------------------------------------------------------------------
# Storage & Knowledge Base Paths
# ------------------------------------------------------------------------------
# Qdrant local embedded disk storage path (runs in-process without Docker)
QDRANT_STORAGE_PATH=./data/qdrant_storage
QDRANT_COLLECTION_NAME=medical_abstracts

# Serialized indices & local files
RAW_DATA_PATH=./data/raw/pubmed_sample.csv
CLEANED_DATA_PATH=./data/processed/cleaned_pubmed.parquet
BM25_INDEX_PATH=./data/processed/bm25_index.pkl
MESH_GRAPH_PATH=./data/processed/mesh_graph.gpickle
MESH_DICT_PATH=./data/processed/mesh_dictionary.json
INDEX_MANIFEST_PATH=./data/manifests/index_manifest.json

# ------------------------------------------------------------------------------
# MedCPT Models & Inference Configuration (FEAT-R1-02)
# ------------------------------------------------------------------------------
MEDCPT_QUERY_ENCODER=ncbi/MedCPT-Query-Encoder
MEDCPT_ARTICLE_ENCODER=ncbi/MedCPT-Article-Encoder
MEDCPT_CROSS_ENCODER=ncbi/MedCPT-Cross-Encoder
MODELS_CACHE_DIR=./data/models_cache

# Explicitly opt in to deterministic mock embeddings only for offline demos/tests.
# Keep false for a real MedCPT knowledge base; missing weights then fail clearly.
MEDCPT_ALLOW_MOCK=false

# Compute device: "auto" (detect CUDA), "cpu", or "cuda"
DEVICE=auto
MEDCPT_KEEP_MODELS_LOADED=false

# MedCPT embedding dimension
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------------------------
# Retrieval & Reranking Hyperparameters
# ------------------------------------------------------------------------------
RRF_K=60
DENSE_TOP_K=30
SPARSE_TOP_K=30
RERANKER_TOP_N=10
MAX_SUBQUERIES=4
MAX_CORRECTIVE_LOOPS=2

# Conversational agent bounds: recent history, input/title sizes, provider request time, planner output.
CONVERSATION_HISTORY_TURN_LIMIT=12
CONVERSATION_MESSAGE_MAX_CHARS=4000
CONVERSATION_TITLE_MAX_CHARS=80
AGENT_OUTPUT_MAX_TOKENS=800

# ------------------------------------------------------------------------------
# FastAPI Service & Logging
# ------------------------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
TRACE_MAX_ENTRIES=500
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
